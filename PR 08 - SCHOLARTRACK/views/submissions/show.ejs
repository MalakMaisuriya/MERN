<div class="page-heading">
  <div>
    <p class="eyebrow">Record details</p>
    <h1><%= submission.title %></h1>
  </div>
  <div class="button-row">
    <a href="/submissions" class="btn btn-light"><i class="bi bi-arrow-left"></i> Back</a>
    <a href="/submissions/<%= submission._id %>/edit" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
  </div>
</div>

<section class="panel detail-panel">
  <div class="detail-header">
    <span class="status-pill <%= submission.status.toLowerCase().replaceAll(' ', '-') %>"><%= submission.status %></span>
    <span class="priority <%= submission.priority.toLowerCase() %>"><%= submission.priority %> priority</span>
  </div>
  <div class="detail-grid">
    <div><span>Subject</span><strong><%= submission.subject %></strong></div>
    <div><span>Type</span><strong><%= submission.type %></strong></div>
    <div><span>Due date</span><strong><%= new Date(submission.dueDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'long', year: 'numeric' }) %></strong></div>
    <div><span>Marks</span><strong><%= submission.marks ?? 'Not added' %></strong></div>
    <div><span>Created</span><strong><%= new Date(submission.createdAt).toLocaleDateString('en-IN') %></strong></div>
    <div><span>Last updated</span><strong><%= new Date(submission.updatedAt).toLocaleDateString('en-IN') %></strong></div>
  </div>
  <div class="notes-box">
    <h2>Notes</h2>
    <p><%= submission.notes || 'No notes added for this submission.' %></p>
  </div>
  <form action="/submissions/<%= submission._id %>?_method=DELETE" method="POST" data-confirm="Delete this submission permanently?">
    <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash"></i> Delete Submission</button>
  </form>
</section>
