<div class="auth-card">
  <div class="auth-copy">
    <p class="eyebrow">Academic workflow</p>
    <h1>Track every submission with clarity.</h1>
    <p>Login to manage practicals, assignments, reports and mini projects from one organized dashboard.</p>
  </div>
  <div class="form-card">
    <h2>Login</h2>
    <p class="text-muted mb-4">Use your registered account to continue.</p>
    <%- include('../partials/validation') %>
    <form action="/auth/login" method="POST" class="stacked-form">
      <div>
        <label for="email" class="form-label">Email address</label>
        <input type="email" class="form-control" id="email" name="email" value="<%= formData.email || '' %>" required>
      </div>
      <div>
        <label for="password" class="form-label">Password</label>
        <input type="password" class="form-control" id="password" name="password" required>
      </div>
      <button class="btn btn-primary w-100" type="submit">Login</button>
    </form>
    <p class="switch-link">New here? <a href="/auth/register">Create an account</a></p>
  </div>
</div>
