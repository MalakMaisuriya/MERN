<%- include('../partials/head') %>

<div class="toolbar-card">
  <form class="filter-form" method="get" action="/categories">
    <div class="input-group" style="max-width: 320px;">
      <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
      <input type="text" class="form-control" name="search" placeholder="Search categories..." value="<%= filters.search || '' %>">
    </div>
    <button type="submit" class="btn btn-dark fw-semibold">Search</button>

    <% if (currentUser && currentUser.role === 'Admin') { %>
      <a href="/categories/new" class="btn btn-primary ms-auto fw-semibold">
        <i class="bi bi-plus-lg me-1"></i> Add Category
      </a>
    <% } %>
  </form>
</div>

<div class="card-panel">
  <div class="table-responsive">
    <table class="table table-custom align-middle">
      <thead>
        <tr>
          <th>Category Name</th>
          <th>Description</th>
          <th>Total Movies</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (items && items.length) { %>
          <% items.forEach(cat => { %>
            <tr>
              <td class="fw-bold">
                <i class="bi bi-tag-fill me-2 text-primary"></i>
                <%= cat.name %>
              </td>
              <td class="text-secondary"><%= cat.description || 'No description available' %></td>
              <td>
                <span class="badge text-bg-light border px-3 py-1.5 fw-semibold">
                  <i class="bi bi-film me-1 text-muted"></i> <%= cat.movieCount %> Movies
                </span>
              </td>
              <td class="text-end">
                <% if (currentUser && currentUser.role === 'Admin') { %>
                  <a href="/categories/<%= cat._id %>/edit" class="btn btn-outline-primary btn-sm me-1">
                    <i class="bi bi-pencil me-1"></i> Edit
                  </a>
                  <form method="post" action="/categories/<%= cat._id %>?_method=DELETE" onsubmit="return confirm('Delete category <%= cat.name %>?');" class="d-inline">
                    <button type="submit" class="btn btn-outline-danger btn-sm">
                      <i class="bi bi-trash me-1"></i> Delete
                    </button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="4" class="text-center text-muted py-4">No categories found matching query.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/pagination', { page, pages, total, filters }) %>
<%- include('../partials/foot') %>
