<header class="topbar">
  <div class="d-flex align-items-center gap-3">
    <button class="btn btn-outline-secondary d-lg-none" id="menuToggle" type="button">
      <i class="bi bi-list fs-5"></i>
    </button>
    <div>
      <span class="topbar-kicker">Movie Rental Management System</span>
      <h1 class="topbar-title"><%= typeof title !== 'undefined' ? title : 'Overview' %></h1>
    </div>
  </div>

  <div class="d-flex align-items-center gap-3">
    <div class="user-badge">
      <div class="user-avatar">
        <%= currentUser ? currentUser.firstName.charAt(0) : 'U' %>
      </div>
      <div class="d-none d-sm-block">
        <div class="fw-semibold lh-1" style="font-size: 0.85rem;">
          <%= currentUser ? `${currentUser.firstName} ${currentUser.lastName}` : 'Guest' %>
        </div>
        <div class="text-muted" style="font-size: 0.72rem;">
          <%= currentUser ? currentUser.role : '' %>
          <% if (currentUser && currentUser.store) { %>
            · <%= currentUser.store.name %>
          <% } %>
        </div>
      </div>
    </div>

    <form method="post" action="/logout" class="m-0">
      <button class="btn btn-light btn-sm text-danger border" title="Logout">
        <i class="bi bi-box-arrow-right"></i>
        <span class="d-none d-md-inline ms-1">Logout</span>
      </button>
    </form>
  </div>
</header>
