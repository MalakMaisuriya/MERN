<%- include('../partials/head', { bodyClass: 'login-body', currentUser: null }) %>
<div class="login-card">
  <div class="text-center mb-4">
    <div class="brand-icon mx-auto mb-3" style="width: 52px; height: 52px; font-size: 1.6rem;">
      <i class="bi bi-film"></i>
    </div>
    <h2 class="fw-bold mb-1" style="font-family: var(--font-heading);">CineLedger</h2>
    <p class="text-muted small">Movie Rental Management System</p>
  </div>

  <%- include('../partials/errors', { errors }) %>

  <form method="post" action="/login" class="needs-validation">
    <div class="mb-3">
      <label class="form-label fw-semibold text-secondary small">Email Address</label>
      <div class="input-group">
        <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
        <input type="email" name="email" class="form-control" placeholder="admin@movierental.com" value="<%= typeof email !== 'undefined' ? email : '' %>" required autofocus>
      </div>
    </div>

    <div class="mb-4">
      <label class="form-label fw-semibold text-secondary small">Password</label>
      <div class="input-group">
        <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
        <input type="password" name="password" class="form-control" placeholder="••••••••" required>
      </div>
    </div>

    <button type="submit" class="btn btn-primary w-100 py-2.5 fw-bold shadow-sm">
      <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Dashboard
    </button>
  </form>

  <div class="mt-4 pt-3 border-top text-center">
    <span class="text-muted extra-small" style="font-size: 0.78rem;">Demo Credentials:</span>
    <div class="d-flex justify-content-center gap-2 mt-1" style="font-size: 0.78rem;">
      <span class="badge text-bg-light border">Admin: admin@movierental.com</span>
      <span class="badge text-bg-light border">Staff: staff@movierental.com</span>
    </div>
  </div>
</div>
<%- include('../partials/foot', { currentUser: null }) %>
