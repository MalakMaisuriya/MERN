<%- include('../partials/head') %>

<div class="card-panel">
  <div class="d-flex align-items-center gap-4 border-bottom pb-4 mb-4">
    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold display-5" style="width: 80px; height: 80px; min-width: 80px;">
      <%= actor.firstName.charAt(0) %><%= actor.lastName.charAt(0) %>
    </div>
    <div>
      <h1 class="fw-bold mb-1" style="font-family: var(--font-heading);"><%= actor.firstName %> <%= actor.lastName %></h1>
      <p class="text-secondary mb-2" style="max-width: 700px;"><%= actor.bio || 'No biography details provided.' %></p>
      <span class="badge text-bg-light border px-3 py-1.5"><i class="bi bi-film me-1 text-primary"></i> <%= actor.movies ? actor.movies.length : 0 %> Associated Movies</span>
    </div>
  </div>

  <h4 class="fw-bold mb-3" style="font-family: var(--font-heading);"><i class="bi bi-collection-play me-2 text-primary"></i> Filmography & Movie Appearances</h4>

  <% if (actor.movies && actor.movies.length) { %>
    <div class="movie-grid">
      <% actor.movies.forEach(movie => { %>
        <a class="movie-card" href="/movies/<%= movie._id %>">
          <div class="movie-poster-wrap" style="height: 220px;">
            <img src="<%= movie.poster || 'https://picsum.photos/seed/movie-' + movie._id + '/500/750' %>" alt="<%= movie.title %>">
          </div>
          <div class="movie-card-body p-3">
            <h6 class="fw-bold mb-1"><%= movie.title %></h6>
            <div class="text-muted small"><%= movie.releaseYear %> · ₹<%= movie.rentalRate %></div>
          </div>
        </a>
      <% }) %>
    </div>
  <% } else { %>
    <div class="p-4 text-center bg-light rounded border text-muted">
      No movies currently linked with <%= actor.firstName %> <%= actor.lastName %>.
    </div>
  <% } %>
</div>

<%- include('../partials/foot') %>
