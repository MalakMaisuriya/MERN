<%- include('../partials/head') %>
<div class="empty-state" style="max-width: 540px; margin: 3rem auto;">
  <i class="bi bi-exclamation-triangle text-danger" style="font-size: 4rem;"></i>
  <h2 class="fw-bold mt-3 mb-2"><%= title || 'Application Error' %></h2>
  <p class="text-muted mb-4"><%= message || 'An unexpected error occurred while processing your request.' %></p>
  <div class="d-flex justify-content-center gap-2">
    <a href="/dashboard" class="btn btn-primary fw-semibold">
      <i class="bi bi-grid-1x2-fill me-1"></i> Return to Dashboard
    </a>
    <button onclick="history.back()" class="btn btn-outline-secondary">Go Back</button>
  </div>
</div>
<%- include('../partials/foot') %>
