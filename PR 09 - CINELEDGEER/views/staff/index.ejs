<%- include('../partials/head') %>

<div class="toolbar-card">
  <div class="d-flex align-items-center justify-content-between">
    <div>
      <h5 class="fw-bold mb-0">System User & Staff Accounts</h5>
      <p class="text-muted small mb-0">Manage Admin and Staff permissions, assigned store locations, and account statuses.</p>
    </div>
    <a href="/staff/new" class="btn btn-primary fw-semibold">
      <i class="bi bi-person-plus me-1"></i> Add Staff Account
    </a>
  </div>
</div>

<div class="card-panel">
  <div class="table-responsive">
    <table class="table table-custom align-middle">
      <thead>
        <tr>
          <th>Staff Name</th>
          <th>Username & Email</th>
          <th>Role</th>
          <th>Assigned Store</th>
          <th>Status</th>
          <th class="text-end">Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (items && items.length) { %>
          <% items.forEach(u => { %>
            <tr>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold small" style="width: 36px; height: 36px;">
                    <%= u.firstName.charAt(0) %><%= u.lastName.charAt(0) %>
                  </div>
                  <div>
                    <div class="fw-bold"><%= u.firstName %> <%= u.lastName %></div>
                    <div class="text-muted extra-small"><%= u.phone || 'No phone' %></div>
                  </div>
                </div>
              </td>
              <td>
                <div class="fw-semibold small"><%= u.email %></div>
                <div class="text-muted extra-small font-monospace">@<%= u.username %></div>
              </td>
              <td>
                <span class="badge <%= u.role === 'Admin' ? 'text-bg-purple' : 'text-bg-info' %> border px-2.5 py-1">
                  <%= u.role %>
                </span>
              </td>
              <td>
                <span class="badge text-bg-light border">
                  <i class="bi bi-shop me-1 text-muted"></i><%= u.store?.name || 'All Stores / Unassigned' %>
                </span>
              </td>
              <td>
                <span class="badge-custom <%= u.active ? 'badge-available' : 'badge-overdue' %>">
                  <%= u.active ? 'Active' : 'Deactivated' %>
                </span>
              </td>
              <td class="text-end">
                <a href="/staff/<%= u._id %>/edit" class="btn btn-outline-primary btn-sm me-1">
                  <i class="bi bi-pencil me-1"></i> Edit
                </a>
                <% if (u.active && u._id.toString() !== currentUser._id.toString()) { %>
                  <form method="post" action="/staff/<%= u._id %>?_method=DELETE" class="d-inline" onsubmit="return confirm('Deactivate this staff account?');">
                    <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-person-x"></i></button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="6" class="text-center text-muted py-4">No staff members found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/pagination', { page, pages, total }) %>
<%- include('../partials/foot') %>
