<%- include('../partials/head') %>

<div class="card-panel" style="max-width: 800px; margin: 0 auto;">
  <div class="card-panel-title border-bottom pb-3 mb-4">
    <span><i class="bi bi-person-plus me-2 text-primary"></i> <%= title %></span>
    <a href="/customers" class="btn btn-outline-secondary btn-sm">Back to Customers</a>
  </div>

  <%- include('../partials/errors', { errors }) %>

  <form method="post" action="<%= customer._id ? '/customers/' + customer._id + '?_method=PUT' : '/customers' %>">
    <div class="row g-3">
      <div class="col-md-6">
        <label class="form-label fw-semibold">First Name <span class="text-danger">*</span></label>
        <input type="text" class="form-control" name="firstName" value="<%= customer.firstName || '' %>" required>
      </div>

      <div class="col-md-6">
        <label class="form-label fw-semibold">Last Name <span class="text-danger">*</span></label>
        <input type="text" class="form-control" name="lastName" value="<%= customer.lastName || '' %>" required>
      </div>

      <div class="col-md-6">
        <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
        <input type="email" class="form-control" name="email" value="<%= customer.email || '' %>" placeholder="name@example.com" required>
      </div>

      <div class="col-md-6">
        <label class="form-label fw-semibold">Phone Number <span class="text-danger">*</span></label>
        <input type="text" class="form-control" name="phone" value="<%= customer.phone || '' %>" placeholder="9876543210" required>
      </div>

      <div class="col-md-6">
        <label class="form-label fw-semibold">Home Store <span class="text-danger">*</span></label>
        <select class="form-select" name="store" required>
          <option value="">Select Primary Store</option>
          <% stores.forEach(s => { %>
            <option value="<%= s._id %>" <%= String(customer.store) === String(s._id) ? 'selected' : '' %>><%= s.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="col-md-6">
        <label class="form-label fw-semibold">Registered Address <span class="text-danger">*</span></label>
        <select class="form-select" name="address" required>
          <option value="">Select Address</option>
          <% addresses.forEach(a => { %>
            <option value="<%= a._id %>" <%= String(customer.address) === String(a._id) ? 'selected' : '' %>>
              <%= a.line1 %>, <%= a.city?.name %> (<%= a.phone %>)
            </option>
          <% }) %>
        </select>
      </div>

      <% if (customer._id) { %>
        <div class="col-12 mt-3">
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" name="active" value="true" id="activeSwitch" <%= customer.active ? 'checked' : '' %>>
            <label class="form-check-label fw-semibold" for="activeSwitch">Customer Account Active</label>
          </div>
        </div>
      <% } %>
    </div>

    <div class="mt-4 pt-3 border-top d-flex gap-2">
      <button type="submit" class="btn btn-primary fw-semibold px-4">
        <i class="bi bi-check-lg me-1"></i> Save Customer
      </button>
      <a href="/customers" class="btn btn-outline-secondary">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/foot') %>
