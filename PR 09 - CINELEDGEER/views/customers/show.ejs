<%- include('../partials/head') %>

<!-- Customer Profile Header Card -->
<div class="card-panel mb-4">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 border-bottom pb-4 mb-4">
    <div class="d-flex align-items-center gap-3">
      <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-2" style="width: 64px; height: 64px;">
        <%= customer.firstName.charAt(0) %><%= customer.lastName.charAt(0) %>
      </div>
      <div>
        <h2 class="fw-bold mb-1" style="font-family: var(--font-heading);"><%= customer.firstName %> <%= customer.lastName %></h2>
        <div class="text-secondary small">
          <span><i class="bi bi-envelope me-1"></i><%= customer.email %></span>
          <span class="mx-2">·</span>
          <span><i class="bi bi-telephone me-1"></i><%= customer.phone %></span>
        </div>
      </div>
    </div>

    <div class="d-flex gap-2">
      <a href="/rentals/new" class="btn btn-success fw-semibold">
        <i class="bi bi-plus-lg me-1"></i> Create Rental
      </a>
      <a href="/customers/<%= customer._id %>/edit" class="btn btn-outline-primary">
        <i class="bi bi-pencil me-1"></i> Edit
      </a>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-md-4">
      <div class="p-3 bg-light rounded border">
        <span class="text-muted small d-block">Registered Home Store</span>
        <strong class="fs-5 text-dark"><i class="bi bi-shop me-1 text-primary"></i><%= customer.store?.name || 'N/A' %></strong>
      </div>
    </div>
    <div class="col-md-4">
      <div class="p-3 bg-light rounded border">
        <span class="text-muted small d-block">Total Movie Rentals</span>
        <strong class="fs-4 text-primary"><%= rentals ? rentals.length : 0 %> Orders</strong>
      </div>
    </div>
    <div class="col-md-4">
      <div class="p-3 bg-light rounded border">
        <span class="text-muted small d-block">Total Lifetime Spending</span>
        <strong class="fs-4 text-success">₹<%= totalSpending.toFixed(2) %></strong>
      </div>
    </div>

    <div class="col-12 mt-3">
      <div class="p-3 border rounded bg-white">
        <h6 class="fw-bold mb-2 text-secondary"><i class="bi bi-geo-alt me-1 text-danger"></i> Complete Address Details</h6>
        <p class="mb-0 text-dark small">
          <strong><%= customer.address?.line1 %></strong>
          <% if (customer.address?.line2) { %>, <%= customer.address.line2 %><% } %>
          <% if (customer.address?.district) { %>, <%= customer.address.district %> District<% } %>
          , <%= customer.address?.city?.name %>, <%= customer.address?.city?.country?.name %>
          <% if (customer.address?.postalCode) { %> (Postal Code: <%= customer.address.postalCode %>)<% } %>
        </p>
      </div>
    </div>
  </div>
</div>

<!-- History Section -->
<div class="row g-4">
  <!-- Rental History -->
  <div class="col-lg-6">
    <div class="card-panel h-100 mb-0">
      <div class="card-panel-title">
        <span><i class="bi bi-clock-history me-2 text-primary"></i> Rental History</span>
        <span class="badge text-bg-light border"><%= rentals.length %> Items</span>
      </div>

      <div class="table-responsive">
        <table class="table table-custom align-middle">
          <thead>
            <tr>
              <th>Movie Title</th>
              <th>Rental Date</th>
              <th>Status</th>
              <th>Amount</th>
            </tr>
          </thead>
          <tbody>
            <% if (rentals && rentals.length) { %>
              <% rentals.forEach(r => { %>
                <tr>
                  <td class="fw-semibold">
                    <a href="/movies/<%= r.inventory?.movie?._id %>" class="text-decoration-none text-dark">
                      <%= r.inventory?.movie?.title || 'Movie' %>
                    </a>
                  </td>
                  <td class="text-muted small"><%= new Date(r.rentalDate).toLocaleDateString() %></td>
                  <td>
                    <span class="badge-custom <%= r.status === 'Active' ? 'badge-rented' : 'badge-available' %>">
                      <%= r.status %>
                    </span>
                  </td>
                  <td class="fw-bold">₹<%= r.rentalAmount.toFixed(2) %></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="4" class="text-center text-muted py-3">No rental history for this customer.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Payment History -->
  <div class="col-lg-6">
    <div class="card-panel h-100 mb-0">
      <div class="card-panel-title">
        <span><i class="bi bi-credit-card me-2 text-success"></i> Payment History</span>
        <span class="badge text-bg-light border"><%= payments.length %> Transactions</span>
      </div>

      <div class="table-responsive">
        <table class="table table-custom align-middle">
          <thead>
            <tr>
              <th>Payment Date</th>
              <th>Method</th>
              <th>Status</th>
              <th>Amount Paid</th>
            </tr>
          </thead>
          <tbody>
            <% if (payments && payments.length) { %>
              <% payments.forEach(p => { %>
                <tr>
                  <td class="text-muted small"><%= new Date(p.paymentDate).toLocaleDateString() %></td>
                  <td><span class="badge text-bg-light border"><%= p.paymentMethod %></span></td>
                  <td>
                    <span class="badge-custom badge-available"><%= p.status %></span>
                  </td>
                  <td class="fw-bold text-success">₹<%= p.amount.toFixed(2) %></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="4" class="text-center text-muted py-3">No payment records found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>
