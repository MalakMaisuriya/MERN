<%- include('../partials/head') %>

<div class="toolbar-card">
  <form class="filter-form" method="get" action="/stores">
    <div class="input-group" style="max-width: 320px;">
      <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
      <input type="text" class="form-control" name="search" placeholder="Search store name..." value="<%= filters.search || '' %>">
    </div>
    <button type="submit" class="btn btn-dark fw-semibold">Search</button>

    <% if (currentUser && currentUser.role === 'Admin') { %>
      <a href="/stores/new" class="btn btn-primary ms-auto fw-semibold">
        <i class="bi bi-shop-window me-1"></i> Add Store Branch
      </a>
    <% } %>
  </form>
</div>

<div class="row g-4">
  <% if (items && items.length) { %>
    <% items.forEach(store => { %>
      <div class="col-md-6 col-lg-4">
        <div class="card-panel h-100 mb-0 d-flex flex-column">
          <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-3">
            <div class="d-flex align-items-center gap-2.5">
              <div class="bg-primary-subtle text-primary rounded p-2 text-center" style="width: 42px; height: 42px;">
                <i class="bi bi-shop fs-5"></i>
              </div>
              <div>
                <h5 class="mb-0 fw-bold"><%= store.name %></h5>
                <span class="badge-custom <%= store.active ? 'badge-available' : 'badge-overdue' %>" style="font-size: 0.7rem;">
                  <%= store.active ? 'Operating' : 'Closed' %>
                </span>
              </div>
            </div>
          </div>

          <div class="mb-3 flex-grow-1">
            <div class="small text-muted mb-1"><i class="bi bi-person-badge me-1 text-primary"></i> Manager:</div>
            <div class="fw-semibold small text-dark mb-2">
              <%= store.manager ? `${store.manager.firstName} ${store.manager.lastName}` : 'Unassigned' %>
            </div>

            <div class="small text-muted mb-1"><i class="bi bi-geo-alt me-1 text-danger"></i> Address:</div>
            <div class="small text-secondary">
              <%= store.address?.line1 %>, <%= store.address?.city?.name %>, <%= store.address?.city?.country?.name %>
            </div>
          </div>

          <div class="pt-3 border-top d-flex justify-content-between align-items-center">
            <a href="/stores/<%= store._id %>" class="btn btn-outline-primary btn-sm fw-semibold">
              Store Dashboard
            </a>
            <% if (currentUser && currentUser.role === 'Admin') { %>
              <div class="btn-group btn-group-sm">
                <a href="/stores/<%= store._id %>/edit" class="btn btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                <form method="post" action="/stores/<%= store._id %>?_method=DELETE" onsubmit="return confirm('Deactivate store branch?');" class="d-inline">
                  <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash"></i></button>
                </form>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <div class="col-12">
      <div class="empty-state">
        <i class="bi bi-shop"></i>
        <h3>No Stores Found</h3>
        <p>No store branches registered yet.</p>
      </div>
    </div>
  <% } %>
</div>

<%- include('../partials/pagination', { page, pages, total, filters }) %>
<%- include('../partials/foot') %>
