<%- include('../partials/head') %>
<main class="auth-shell">
  <section class="auth-panel">
    <a class="brand auth-brand" href="/"><span class="brand-mark">SV</span><span><%= appName %></span></a>
    <div class="auth-copy">
      <p class="eyebrow">Create workspace</p>
      <h1>Start managing smarter.</h1>
      <p>Build a secure admin profile before adding student records.</p>
    </div>

    <form class="form-card" action="/register" method="POST" novalidate>
      <div>
        <label for="name">Full name</label>
        <input id="name" name="name" type="text" value="<%= form.name || '' %>" placeholder="Your name" required>
        <% if (errors.name) { %><small class="field-error"><%= errors.name %></small><% } %>
      </div>
      <div>
        <label for="email">Email address</label>
        <input id="email" name="email" type="email" value="<%= form.email || '' %>" placeholder="you@example.com" required>
        <% if (errors.email) { %><small class="field-error"><%= errors.email %></small><% } %>
      </div>
      <div>
        <label for="password">Password</label>
        <input id="password" name="password" type="password" placeholder="Minimum 8 characters" required>
        <% if (errors.password) { %><small class="field-error"><%= errors.password %></small><% } %>
      </div>
      <button class="primary-button full" type="submit">
        <i class="bi bi-shield-lock"></i> Create account
      </button>
      <p class="form-note">Already have an account? <a href="/login">Sign in</a></p>
    </form>
  </section>
  <section class="auth-visual register" aria-hidden="true">
    <div class="metric-card floating one"><span>CRUD</span><small>Complete workflow</small></div>
    <div class="metric-card floating two"><span>JWT</span><small>Session style auth</small></div>
    <div class="glass-grid"></div>
  </section>
</main>
<%- include('../partials/flash') %>
<%- include('../partials/footer') %>
