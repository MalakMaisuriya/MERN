<header class="topbar">
  <a class="brand" href="/dashboard" aria-label="<%= appName %> dashboard">
    <span class="brand-mark">SV</span>
    <span><%= appName %></span>
  </a>

  <% if (currentUser) { %>
    <nav class="topnav" aria-label="Primary navigation">
      <a class="<%= currentPath === '/dashboard' ? 'active' : '' %>" href="/dashboard">
        <i class="bi bi-grid-1x2-fill"></i> Dashboard
      </a>
      <a class="<%= currentPath.startsWith('/students') ? 'active' : '' %>" href="/students">
        <i class="bi bi-people-fill"></i> Students
      </a>
    </nav>

    <div class="top-actions">
      <button class="icon-button" type="button" data-theme-toggle aria-label="Toggle theme">
        <i class="bi bi-moon-stars"></i>
      </button>
      <form action="/logout" method="POST">
        <button class="ghost-button" type="submit">
          <i class="bi bi-box-arrow-right"></i> Logout
        </button>
      </form>
    </div>
  <% } %>
</header>
