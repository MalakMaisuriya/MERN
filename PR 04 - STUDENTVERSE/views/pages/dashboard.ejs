<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main class="page-shell">
  <section class="page-hero">
    <div>
      <p class="eyebrow">Academic operations</p>
      <h1>Student command center</h1>
      <p>Track enrollments, course load and placement movement with a clean admin workflow.</p>
    </div>
    <a class="primary-button" href="/students/new"><i class="bi bi-person-plus-fill"></i> Add student</a>
  </section>

  <section class="stats-grid" aria-label="Dashboard metrics">
    <article class="stat-card"><span>Total students</span><strong><%= stats.totalStudents %></strong><i class="bi bi-people"></i></article>
    <article class="stat-card"><span>Active</span><strong><%= stats.activeStudents %></strong><i class="bi bi-lightning-charge"></i></article>
    <article class="stat-card"><span>Placed</span><strong><%= stats.placedStudents %></strong><i class="bi bi-trophy"></i></article>
    <article class="stat-card"><span>Courses</span><strong><%= stats.courseCount %></strong><i class="bi bi-layers"></i></article>
  </section>

  <section class="content-grid">
    <article class="panel">
      <div class="panel-head">
        <div>
          <h2>Course distribution</h2>
          <p>Live count by enrolled course.</p>
        </div>
      </div>
      <% if (courses.length) { %>
        <div class="chart-list">
          <% const topCourse = courses[0]?.total || 1; %>
          <% courses.forEach((course) => { %>
            <div class="chart-row">
              <div><strong><%= course._id %></strong><span><%= course.total %> students</span></div>
              <div class="bar"><span style="width:<%= Math.max((course.total / topCourse) * 100, 8) %>%"></span></div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state compact"><i class="bi bi-bar-chart"></i><p>No course data yet.</p></div>
      <% } %>
    </article>

    <article class="panel">
      <div class="panel-head">
        <div>
          <h2>Recent students</h2>
          <p>Latest profiles added to the system.</p>
        </div>
        <a class="link-button" href="/students">View all</a>
      </div>
      <% if (recentStudents.length) { %>
        <div class="activity-list">
          <% recentStudents.forEach((student) => { %>
            <a href="/students/<%= student._id %>" class="activity-item">
              <span class="avatar"><%= student.name.charAt(0).toUpperCase() %></span>
              <span><strong><%= student.name %></strong><small><%= student.course %></small></span>
              <em><%= student.status %></em>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state compact"><i class="bi bi-person-plus"></i><p>Add your first student to see activity.</p></div>
      <% } %>
    </article>
  </section>
</main>
<%- include('../partials/flash') %>
<%- include('../partials/footer') %>
