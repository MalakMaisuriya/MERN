<%- include('../partials/head') %>
<div class="auth-container">
  <div class="auth-box">
    <div class="auth-header">
      <div class="brand-logo">
        <i class="bi bi-mortarboard-fill"></i>
      </div>
      <h2>Create Admin Account</h2>
      <p class="auth-subtitle">Register your details below to set up your account</p>
    </div>

    <form class="auth-form" action="/register" method="POST" novalidate autocomplete="off">
      <div class="form-field">
        <label for="name">Full Name</label>
        <div class="input-wrapper">
          <i class="bi bi-person"></i>
          <input id="name" name="name" type="text" value="<%= (typeof form !== 'undefined' && form.name) ? form.name : '' %>" placeholder="e.g. Malak Maisuriya" required autocomplete="off">
        </div>
        <% if (typeof errors !== 'undefined' && errors.name) { %><small class="error-msg"><%= errors.name %></small><% } %>
      </div>

      <div class="form-field">
        <label for="email">Email Address</label>
        <div class="input-wrapper">
          <i class="bi bi-envelope"></i>
          <input id="email" name="email" type="email" value="<%= (typeof form !== 'undefined' && form.email) ? form.email : '' %>" placeholder="name@domain.com" required autocomplete="off">
        </div>
        <% if (typeof errors !== 'undefined' && errors.email) { %><small class="error-msg"><%= errors.email %></small><% } %>
      </div>

      <div class="form-field">
        <label for="password">Password</label>
        <div class="input-wrapper">
          <i class="bi bi-lock"></i>
          <input id="password" name="password" type="password" placeholder="Minimum 8 characters" required autocomplete="off">
        </div>
        <% if (typeof errors !== 'undefined' && errors.password) { %><small class="error-msg"><%= errors.password %></small><% } %>
      </div>

      <button class="btn-submit" type="submit">
        Register Account <i class="bi bi-person-plus"></i>
      </button>
    </form>

    <div class="auth-footer">
      <span>Already have an account?</span>
      <a href="/login">Sign in here</a>
    </div>
  </div>
</div>
<%- include('../partials/flash') %>
<%- include('../partials/footer') %>
