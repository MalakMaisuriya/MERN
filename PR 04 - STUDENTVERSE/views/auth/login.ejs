<%- include('../partials/head') %>
<main class="auth-shell">
  <section class="auth-panel">
    <a class="brand auth-brand" href="/"><span class="brand-mark">SV</span><span><%= appName %></span></a>
    <div class="auth-copy">
      <p class="eyebrow">Admin workspace</p>
      <h1>Welcome back.</h1>
      <p>Manage students, courses and placement status from one polished dashboard.</p>
    </div>

    <form class="form-card" action="/login" method="POST" novalidate>
      <div>
        <label for="email">Email address</label>
        <input id="email" name="email" type="email" value="<%= form.email || '' %>" placeholder="admin@studentverse.test" required>
        <% if (errors.email) { %><small class="field-error"><%= errors.email %></small><% } %>
      </div>
      <div>
        <label for="password">Password</label>
        <input id="password" name="password" type="password" placeholder="Your password" required>
        <% if (errors.password) { %><small class="field-error"><%= errors.password %></small><% } %>
      </div>
      <button class="primary-button full" type="submit">
        <i class="bi bi-arrow-right-circle"></i> Sign in
      </button>
      <p class="form-note">New here? <a href="/register">Create an admin account</a></p>
    </form>
  </section>
  <section class="auth-visual" aria-hidden="true">
    <div class="metric-card floating one"><span>94%</span><small>Profile completion</small></div>
    <div class="metric-card floating two"><span>18</span><small>Active courses</small></div>
    <div class="glass-grid"></div>
  </section>
</main>
<%- include('../partials/flash') %>
<%- include('../partials/footer') %>
