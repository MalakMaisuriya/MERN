<%- include('../partials/head') %>
<div class="auth-container">
  <div class="auth-box">
    <div class="auth-header">
      <div class="brand-logo">
        <i class="bi bi-mortarboard-fill"></i>
      </div>
      <h2>StudentVerse Admin</h2>
      <p class="auth-subtitle">Sign in to access your student management dashboard</p>
    </div>

    <form class="auth-form" action="/login" method="POST" novalidate autocomplete="off">
      <div class="form-field">
        <label for="email">Email Address</label>
        <div class="input-wrapper">
          <i class="bi bi-envelope"></i>
          <input id="email" name="email" type="email" value="<%= (typeof form !== 'undefined' && form.email) ? form.email : '' %>" placeholder="name@domain.com" required autocomplete="off">
        </div>
        <% if (typeof errors !== 'undefined' && errors.email) { %><small class="error-msg"><%= errors.email %></small><% } %>
      </div>

      <div class="form-field">
        <label for="password">Password</label>
        <div class="input-wrapper">
          <i class="bi bi-lock"></i>
          <input id="password" name="password" type="password" placeholder="••••••••" required autocomplete="off">
        </div>
        <% if (typeof errors !== 'undefined' && errors.password) { %><small class="error-msg"><%= errors.password %></small><% } %>
      </div>

      <button class="btn-submit" type="submit">
        Sign In <i class="bi bi-arrow-right"></i>
      </button>
    </form>

    <div class="auth-footer">
      <span>Don't have an account?</span>
      <a href="/register">Register here</a>
    </div>
  </div>
</div>
<%- include('../partials/flash') %>
<%- include('../partials/footer') %>
