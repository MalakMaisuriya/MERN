<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main class="page-shell narrow">
  <section class="list-header">
    <div>
      <p class="eyebrow"><%= mode === 'create' ? 'New profile' : 'Profile editor' %></p>
      <h1><%= mode === 'create' ? 'Add student' : 'Edit student' %></h1>
      <p>Keep academic, contact and placement details accurate.</p>
    </div>
    <a class="ghost-button" href="/students"><i class="bi bi-arrow-left"></i> Back</a>
  </section>

  <form class="editor-form" action="<%= mode === 'create' ? '/students' : `/students/${student._id}?_method=PUT` %>" method="POST" novalidate>
    <div class="form-grid">
      <div>
        <label for="name">Full name</label>
        <input id="name" name="name" type="text" value="<%= student.name || '' %>" placeholder="Aarav Mehta" required>
        <% if (errors.name) { %><small class="field-error"><%= errors.name %></small><% } %>
      </div>
      <div>
        <label for="email">Email</label>
        <input id="email" name="email" type="email" value="<%= student.email || '' %>" placeholder="student@example.com" required>
        <% if (errors.email) { %><small class="field-error"><%= errors.email %></small><% } %>
      </div>
      <div>
        <label for="phone">Phone</label>
        <input id="phone" name="phone" type="tel" value="<%= student.phone || '' %>" placeholder="9876543210" required>
        <% if (errors.phone) { %><small class="field-error"><%= errors.phone %></small><% } %>
      </div>
      <div>
        <label for="enrollmentNumber">Enrollment number</label>
        <input id="enrollmentNumber" name="enrollmentNumber" type="text" value="<%= student.enrollmentNumber || '' %>" placeholder="SV-2026-004" required>
        <% if (errors.enrollmentNumber) { %><small class="field-error"><%= errors.enrollmentNumber %></small><% } %>
      </div>
      <div>
        <label for="course">Course</label>
        <select id="course" name="course" required>
          <option value="">Select course</option>
          <% options.courses.forEach((course) => { %>
            <option value="<%= course %>" <%= student.course === course ? 'selected' : '' %>><%= course %></option>
          <% }) %>
        </select>
        <% if (errors.course) { %><small class="field-error"><%= errors.course %></small><% } %>
      </div>
      <div>
        <label for="semester">Semester</label>
        <input id="semester" name="semester" type="number" min="1" max="8" value="<%= student.semester || '' %>" placeholder="4" required>
        <% if (errors.semester) { %><small class="field-error"><%= errors.semester %></small><% } %>
      </div>
      <div>
        <label for="status">Status</label>
        <select id="status" name="status" required>
          <% options.statuses.forEach((status) => { %>
            <option value="<%= status %>" <%= (student.status || 'active') === status ? 'selected' : '' %>><%= status %></option>
          <% }) %>
        </select>
        <% if (errors.status) { %><small class="field-error"><%= errors.status %></small><% } %>
      </div>
      <div>
        <label for="grade">Grade</label>
        <select id="grade" name="grade" required>
          <% options.grades.forEach((grade) => { %>
            <option value="<%= grade %>" <%= (student.grade || 'B+') === grade ? 'selected' : '' %>><%= grade %></option>
          <% }) %>
        </select>
        <% if (errors.grade) { %><small class="field-error"><%= errors.grade %></small><% } %>
      </div>
      <div>
        <label for="city">City</label>
        <input id="city" name="city" type="text" value="<%= student.city || '' %>" placeholder="Ahmedabad">
        <% if (errors.city) { %><small class="field-error"><%= errors.city %></small><% } %>
      </div>
      <div class="wide">
        <label for="notes">Notes</label>
        <textarea id="notes" name="notes" rows="4" placeholder="Scholarship, placement or performance notes"><%= student.notes || '' %></textarea>
        <% if (errors.notes) { %><small class="field-error"><%= errors.notes %></small><% } %>
      </div>
    </div>
    <div class="form-actions">
      <button class="primary-button" type="submit">
        <i class="bi bi-check2-circle"></i> <%= mode === 'create' ? 'Create profile' : 'Save changes' %>
      </button>
      <a class="ghost-button" href="/students">Cancel</a>
    </div>
  </form>
</main>
<%- include('../partials/flash') %>
<%- include('../partials/footer') %>
