<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main class="page-shell narrow">
  <section class="profile-hero">
    <span class="avatar large"><%= student.name.charAt(0).toUpperCase() %></span>
    <div>
      <p class="eyebrow"><%= student.enrollmentNumber %></p>
      <h1><%= student.name %></h1>
      <p><%= student.course %></p>
    </div>
    <span class="status-pill <%= student.status %>"><%= student.status %></span>
  </section>

  <section class="detail-grid">
    <article class="panel">
      <h2>Contact</h2>
      <dl class="detail-list">
        <div><dt>Email</dt><dd><%= student.email %></dd></div>
        <div><dt>Phone</dt><dd><%= student.phone %></dd></div>
        <div><dt>City</dt><dd><%= student.city || 'Not provided' %></dd></div>
      </dl>
    </article>
    <article class="panel">
      <h2>Academic</h2>
      <dl class="detail-list">
        <div><dt>Semester</dt><dd><%= student.semester %></dd></div>
        <div><dt>Grade</dt><dd><%= student.grade %></dd></div>
        <div><dt>Created</dt><dd><%= student.createdAt.toLocaleDateString('en-IN') %></dd></div>
      </dl>
    </article>
  </section>

  <section class="panel">
    <h2>Notes</h2>
    <p class="muted"><%= student.notes || 'No notes added for this student.' %></p>
  </section>

  <div class="form-actions">
    <a class="primary-button" href="/students/<%= student._id %>/edit"><i class="bi bi-pencil-square"></i> Edit profile</a>
    <a class="ghost-button" href="/students"><i class="bi bi-arrow-left"></i> Back to students</a>
  </div>
</main>
<%- include('../partials/flash') %>
<%- include('../partials/footer') %>
