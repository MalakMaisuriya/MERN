<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container">
    <div class="page-header">
      <div>
        <h2><%= title %></h2>
      </div>

      <div class="header-actions">
        <% if (locals.user && locals.user.role === 'admin') { %>
          <% if (typeof viewAll !== 'undefined' && viewAll) { %>
            <a href="/tasks" class="btn btn-secondary">Show My Tasks</a>
          <% } else { %>
            <a href="/tasks?view=all" class="btn btn-secondary">Show All User Tasks</a>
          <% } %>
        <% } %>
        <a href="/tasks/new" class="btn btn-primary">+ New Task</a>
      </div>
    </div>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <% if (success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <% if (tasks && tasks.length > 0) { %>
      <div class="task-grid">
        <% tasks.forEach(task => { %>
          <%- include('partials/taskItem', { task: task }) %>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <p>No tasks found.</p>
        <a href="/tasks/new" class="btn btn-primary" style="margin-top: 10px;">+ Add Task</a>
      </div>
    <% } %>
  </main>
</body>
</html>
