<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | TaskFlow</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container">
    <div class="page-header">
      <div>
        <h1 class="page-title">Task Categories</h1>
        <p class="page-subtitle">Manage task categories used across the application.</p>
      </div>
    </div>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <% if (success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <div class="grid-2col">
      <div class="card">
        <h3>Add New Category</h3>
        <form action="/categories" method="POST" class="form" style="margin-top: 1rem;">
          <div class="form-group">
            <label for="name">Category Name <span class="required">*</span></label>
            <input type="text" id="name" name="name" placeholder="e.g. Design, Urgent, Finance" required>
          </div>
          <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" rows="2" placeholder="Brief category description"></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Add Category</button>
        </form>
      </div>

      <div class="card">
        <h3>Existing Categories</h3>
        <div class="category-list" style="margin-top: 1rem;">
          <% categories.forEach(cat => { %>
            <div class="category-item-card">
              <div>
                <strong><%= cat.name %></strong>
                <% if (cat.description) { %>
                  <p class="muted-text"><%= cat.description %></p>
                <% } %>
              </div>
              <% if (locals.user && locals.user.role === 'admin') { %>
                <form action="/categories/delete/<%= cat._id %>" method="POST" onsubmit="return confirm('Delete this category?');">
                  <button type="submit" class="btn-icon delete-btn">Delete</button>
                </form>
              <% } %>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </main>
</body>
</html>
