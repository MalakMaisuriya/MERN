<article class="detail-page">
  <header class="detail-hero">
    <div class="container-xl detail-hero-inner glass-panel">
      <span class="topic-pill" style="--pill-color: <%= publication.topic.accentColor %>"><%= publication.topic.title %></span>
      <h1><%= publication.headline %></h1>
      <p class="detail-summary"><%= publication.summary %></p>
      <div class="detail-meta">
        <span>By <%= publication.author.fullName %></span>
        <span><%= publication.readingMinutes %> min read</span>
        <span><%= publication.viewCount + 1 %> views</span>
      </div>
    </div>
  </header>

  <div class="container-xl detail-layout">
    <div class="detail-content glass-panel">
      <% if (publication.coverImage) { %>
        <figure class="detail-cover">
          <img src="<%= publication.coverImage %>" alt="">
        </figure>
      <% } %>
      <div class="article-body">
        <% publication.body.split('\n').forEach(function(paragraph) { %>
          <% if (paragraph.trim()) { %><p><%= paragraph %></p><% } %>
        <% }) %>
      </div>
    </div>

    <% if (related.length) { %>
      <aside class="detail-aside">
        <h2>Related Reads</h2>
        <% related.forEach(function(item) { %>
          <a href="/read/<%= item.slug %>" class="related-card glass-panel">
            <h3><%= item.headline %></h3>
            <p><%= item.summary %></p>
          </a>
        <% }) %>
      </aside>
    <% } %>
  </div>
</article>
