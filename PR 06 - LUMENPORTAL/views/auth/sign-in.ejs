<section class="auth-card glass-panel">
  <header class="auth-card-header">
    <h2>Welcome back</h2>
    <p>Sign in to manage campus publications</p>
  </header>

  <form action="/auth/sign-in" method="POST" class="premium-form" novalidate>
    <div class="form-group">
      <label for="email">Email address</label>
      <input
        type="email"
        id="email"
        name="email"
        value="<%= formData.email || '' %>"
        autocomplete="email"
        required
        class="<%= fieldErrors && fieldErrors.email ? 'is-invalid' : '' %>"
      >
      <% if (fieldErrors && fieldErrors.email) { %>
        <span class="field-error"><%= fieldErrors.email %></span>
      <% } %>
    </div>

    <div class="form-group">
      <label for="password">Password</label>
      <input
        type="password"
        id="password"
        name="password"
        autocomplete="current-password"
        required
        class="<%= fieldErrors && fieldErrors.password ? 'is-invalid' : '' %>"
      >
      <% if (fieldErrors && fieldErrors.password) { %>
        <span class="field-error"><%= fieldErrors.password %></span>
      <% } %>
    </div>

    <button type="submit" class="btn-gradient w-100">Sign In</button>
  </form>

  <p class="auth-switch">No account yet? <a href="/auth/sign-up">Create one</a></p>
</section>
