<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' - NodePanel Admin' : 'NodePanel Admin Dashboard' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="app-container">
    <!-- Sidebar Navigation -->
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="sidebar-logo-icon">N</div>
        <span class="sidebar-title">NodePanel</span>
      </div>

      <nav class="sidebar-nav">
        <div class="nav-label">Main Navigation</div>
        <a href="/" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>">
          <span class="nav-icon">📊</span>
          <span>Dashboard</span>
        </a>
        <a href="/items" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'items' ? 'active' : '' %>">
          <span class="nav-icon">📁</span>
          <span>Manage Items</span>
        </a>
        <a href="/items/add" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'add-item' ? 'active' : '' %>">
          <span class="nav-icon">➕</span>
          <span>Add New Record</span>
        </a>

        <div class="nav-label" style="margin-top: 16px;">System</div>
        <a href="/settings" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'settings' ? 'active' : '' %>">
          <span class="nav-icon">⚙️</span>
          <span>Settings</span>
        </a>
      </nav>

      <div class="sidebar-footer">
        <div class="user-avatar">AD</div>
        <div class="user-info">
          <span class="user-name">Admin User</span>
          <span class="user-role">Super Administrator</span>
        </div>
      </div>
    </aside>

    <!-- Main Wrapper -->
    <div class="main-wrapper">
      <!-- Navbar -->
      <header class="navbar">
        <div class="page-title-group">
          <h1><%= typeof pageHeader !== 'undefined' ? pageHeader : 'Dashboard' %></h1>
          <p><%= typeof pageSubheader !== 'undefined' ? pageSubheader : 'Welcome back to NodePanel Control Center' %></p>
        </div>

        <div class="nav-actions">
          <span class="status-badge-online">
            <span class="dot"></span> Server Active
          </span>
        </div>
      </header>

      <!-- Content Body -->
      <main class="content-body">