<%- include('partials/header', { title: 'Edit Record', activePage: 'items', pageHeader: 'Update Record #' + item.id, pageSubheader: 'Modify record properties and details' }) %>

<div class="panel-card" style="max-width: 700px; margin: 0 auto;">
  <div class="panel-header">
    <h2 class="panel-title">Editing: <%= item.name %></h2>
  </div>

  <!-- Edit Record Form -->
  <form action="/items/edit/<%= item.id %>" method="POST">
    <!-- Item Name -->
    <div class="form-group">
      <label class="form-label" for="name">Record / Item Name *</label>
      <input type="text" id="name" name="name" class="form-control" value="<%= item.name %>" required>
    </div>

    <div class="form-row">
      <!-- Category Selection -->
      <div class="form-group">
        <label class="form-label" for="category">Category *</label>
        <select id="category" name="category" class="form-control" required>
          <option value="Services" <%= item.category === 'Services' ? 'selected' : '' %>>Services</option>
          <option value="Database" <%= item.category === 'Database' ? 'selected' : '' %>>Database</option>
          <option value="Security" <%= item.category === 'Security' ? 'selected' : '' %>>Security</option>
          <option value="Frontend" <%= item.category === 'Frontend' ? 'selected' : '' %>>Frontend</option>
          <option value="DevOps" <%= item.category === 'DevOps' ? 'selected' : '' %>>DevOps</option>
        </select>
      </div>

      <!-- Owner Input -->
      <div class="form-group">
        <label class="form-label" for="owner">Owner / Responsible Lead *</label>
        <input type="text" id="owner" name="owner" class="form-control" value="<%= item.owner %>" required>
      </div>
    </div>

    <!-- Status Selection -->
    <div class="form-group">
      <label class="form-label" for="status">Status *</label>
      <select id="status" name="status" class="form-control" required>
        <option value="Active" <%= item.status === 'Active' ? 'selected' : '' %>>Active</option>
        <option value="Inactive" <%= item.status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
      </select>
    </div>

    <!-- Description Input -->
    <div class="form-group">
      <label class="form-label" for="description">Description / Operational Notes</label>
      <textarea id="description" name="description" class="form-control" rows="4"><%= item.description || '' %></textarea>
    </div>

    <!-- Action Controls -->
    <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 24px;">
      <a href="/items" class="btn btn-secondary">Cancel</a>
      <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
